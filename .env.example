# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional override of the primary LLM endpoint / model
LLM_BASE_URL=
# LLM_MODEL=

# Local Ollama (step 11). Setting OLLAMA_BASE_URL turns the automatic fallback on: when Groq times out or stays
# rate-limited, the call is repeated on Ollama. From the Docker container use host.docker.internal.
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# LLM_BACKEND=ollama        # make Ollama the primary instead (model names: llm.ollama in config.yaml)

# Langfuse tracing (step 11): on only when both keys are set. Never commit them.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# DOCQA_API_URL=http://localhost:8000
# Dev/eval only: cache LLM responses on disk (data/llm_cache). Never set in production.
# DOCQA_LLM_CACHE=1
